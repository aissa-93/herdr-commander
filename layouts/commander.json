{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "menubar",
      "type": "block",
      "content": { "mod": "cmdr-menubar" },
      "size": { "px": 22.22 },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "content": { "mod": "cmdr-tree" },
          "size": { "px": 305.56 },
          "min": 180,
          "max": 480
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": { "mod": "cmdr-tabs" },
              "size": { "px": 22.22 }
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": { "mod": "cmdr-pane" },
                        "reveal": "always",
                        "height": 20.83,
                        "position": "top"
                      },
                      "background": "background",
                      "border": { "width": 1, "color": "border" },
                      "focus": { "width": 1, "color": "accent" },
                      "radius": 0,
                      "gap": 5.56,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        { "id": "files", "type": "block", "content": { "mod": "files" } },
                        { "id": "changes", "type": "block", "content": { "mod": "changes" } },
                        { "id": "notes", "type": "block", "content": { "mod": "cmdr-notes" } }
                      ],
                      "active": "notes"
                    }
                  ],
                  "size": { "px": 368 },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "border": { "width": 1, "color": "border" }
                }
              ],
              "gap": 5.56
            }
          ],
          "gap": 5.56,
          "resizable": false
        }
      ],
      "padding": [5.56, 5.56],
      "gap": 5.56
    },
    {
      "id": "keybar",
      "type": "block",
      "content": { "mod": "cmdr-keys" },
      "size": { "px": 22.22 }
    }
  ],
  "resizable": false,
  "background": "canvas",
  "terminal_padding": [8, 6],
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "theme": { "light": "commander-navy", "dark": "commander" },
  "font": "PxPlus IBM VGA 8x16",
  "font_size": 14,
  "ui_font": "PxPlus IBM VGA 8x16",
  "preview": "layouts/commander.svg"
}
